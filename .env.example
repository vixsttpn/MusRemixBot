# ============ TELEGRAM ============
# Получите на https://t.me/BotFather
BOT_TOKEN=

# Ваш Telegram ID для админ функций
ADMIN_ID=

# ============ VK API ============
# Сервисный ключ доступа VK
# Получите на https://vk.com/dev
VK_TOKEN=

# Версия VK API
VK_VERSION=5.131

# ============ VOICE RECOGNITION ============
# Yandex SpeechKit API ключ (опционально)
# https://cloud.yandex.ru/services/speechkit
YANDEX_SPEECH_KEY=

# Google Cloud Speech API (опционально)
# https://cloud.google.com/speech-to-text
GOOGLE_SPEECH_KEY=

# ============ PATHS ============
# Директория для временных файлов
TEMP_DIR=/tmp/remix_bot

# Директория логов
LOG_DIR=./logs

# Директория ассетов (картинок)
ASSETS_DIR=./assets

# ============ SETTINGS ============
# Максимум результатов поиска на странице
MAX_SEARCH_RESULTS=5

# Максимум всего результатов для кэширования
MAX_TOTAL_RESULTS=50

# Максимальная длительность голосового сообщения (сек)
VOICE_MAX_DURATION=60

# Максимальный размер аудиофайла (байты)
AUDIO_MAX_SIZE=52428800

# Таймаут обработки ремикса (сек)
REMIX_TIMEOUT=120

# ============ SEARCH ============
# Порог fuzzy-поиска (0.0-1.0)
FUZZY_THRESHOLD=0.6

# Таймаут поиска (сек)
SEARCH_TIMEOUT=10

# ============ CACHE ============
# TTL кэша в секундах
CACHE_TTL=3600

# Включить кэширование
ENABLE_CACHE=true

# ============ DEBUG ============
# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
